# Cloudflare R2 credentials for the production backend.
# Keep real values in the deployment secret manager; rotate any values exposed in chat.
# Endpoint format: https://<Cloudflare account ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saporini-assets
# Optional: a production custom HTTPS domain for the bucket. Empty: the backend serves the photos itself.
# r2.dev URLs are rate-limited development endpoints; use them only for local testing.
R2_PUBLIC_BASE_URL=
# Where dish photos are stored: r2 (production), local (development folder) or disabled.
MENU_IMAGE_STORAGE_PROVIDER=r2

# Email (owner invitations, password resets). Any SMTP provider works; use its submission port with STARTTLS.
# The sending domain needs SPF, DKIM and DMARC records from the provider, or invitations land in spam.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# The address emails come from; must be on the domain set up with the provider.
MAIL_FROM=
# The public https address of this backend (required in production: it refuses to start without it).
# Invitation and reset emails link to its page /public/account/password.
PUBLIC_BASE_URL=
# How long an owner's invitation link works (reset links: PASSWORD_RESET_TOKEN_TTL, 30m).
OWNER_INVITE_TOKEN_TTL=72h

# Public restaurant applications (reviewed by a super admin before the restaurant exists). false: only super admins
# create restaurants; applicants can still check earlier applications with their code.
APP_PUBLIC_REGISTRATION_ENABLED=true
# Limits for applications and status checks (per IP address, per owner email).
APP_APPLICATIONS_MAX_PER_IP=5
APP_APPLICATIONS_IP_WINDOW_MINUTES=60
APP_APPLICATIONS_MAX_PER_EMAIL=3
APP_APPLICATIONS_EMAIL_WINDOW_HOURS=24
APP_APPLICATIONS_STATUS_CHECKS_PER_IP=30
APP_APPLICATIONS_STATUS_WINDOW_MINUTES=10
